{
  "dev": {
    "name": "Development",
    "model": "openai/clip-vit-base-patch32",
    "description": "Fast, lightweight model for testing on Ubuntu",
    "batch_size": 4,
    "device": "cpu",
    "max_images": 100
  },
  "production": {
    "name": "Production",
    "model": "openai/clip-vit-large-patch14",
    "description": "Best quality CLIP model with CUDA GPU acceleration",
    "batch_size": 16,
    "device": "cuda",
    "max_images": 1000
  },
  "default_labels": [
    "person",
    "car",
    "nature",
    "food",
    "text or screenshot",
    "animals"
  ],
  "image_formats": {
    "jpg": "image/jpeg",
    "jpeg": "image/jpeg",
    "png": "image/png",
    "webp": "image/webp",
    "bmp": "image/bmp",
    "gif": "image/gif",
    "tiff": "image/tiff",
    "ico": "image/x-icon",
    "ppm": "image/x-portable-pixmap"
  },
  "export_formats": ["json", "csv", "excel", "pdf"]
}
